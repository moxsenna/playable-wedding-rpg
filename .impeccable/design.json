  "narrative": {
    "northStar": "Arsip Kenangan",
    "overview": "YUTEMU terlihat seperti album kenangan yang dibuka bersama orang tersayang: premium tapi dekat, tidak pernah jauh atau formal. Latar senja yang dalam menahan konten, dan cahaya lentera emas menandai satu-satunya hal yang penting di setiap layar. Game-nya boleh magis; perkakasnya tertib seperti arsip yang terawat.",
    "keyCharacteristics": [
      "Senja yang tenang, bukan neon yang ramai.",
      "Satu aksen emas untuk semua tindakan dan status penting.",
      "Tertib arsip: hierarki jelas, kepadatan disengaja, tidak ada dekorasi tanpa tugas."
    ],
    "rules": [
      {
        "name": "The One Lantern Rule",
        "body": "Aksen emas muncul hanya untuk tindakan, pilihan aktif, dan status.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Georgia berbicara kepada hati; sans bekerja untuk tangan. Jangan tertukar.",
        "section": "typography"
      },
      {
        "name": "The Resting Flat Rule",
        "body": "Kartu dan section diam tanpa bayangan; depth datang dari tone.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pakai emas Lentera (#ffd98a) hanya untuk tindakan, pilihan aktif, dan status.",
      "Do jaga tinggi sentuh min 44px untuk semua kontrol.",
      "Do beri setiap destructive action konfirmasi dan setiap daftar kosong empty state yang mengajari.",
      "Do redupkan teks sekunder dari rona tinta (#b9b3d4), bukan abu-abu netral."
    ],
    "donts": [
      "Don't memakai estetika kasino/mobile-game generik.",
      "Don't mendinginkan Studio menjadi SaaS korporat.",
      "Don't menaruh teks di atas tile logo krem kecuali dengan tinta gelap.",
      "Don't menduplikasi `data-testid` antar dua tombol."
    ]
  }
