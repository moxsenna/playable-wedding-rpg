{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "wedding-rpg-realtime",
  "main": "src/room.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "WEDDING_ROOM", "class_name": "WeddingRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WeddingRoom"] }]
}
